    "# 08 — C-NMC classifier environment\n",
    "\n",
    "**Purpose:** Check the existing Conda/Jupyter/CUDA environment and C-NMC path.\n",
    "\n",
    "**Required inputs:** Existing leukemia-yolo environment; `cnmc_root` in config.local.yaml.\n",
    "\n",
    "**Saved outputs:** outputs/classifier/environment_report.json."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "19955e5b",
   "metadata": {},
   "source": [
    "## 1. Load central configuration\n",
    "\n",
    "Set `cnmc_root` once in ignored `config.local.yaml`. Source images are never moved or changed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "39ed88c2",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import os, sys\n",
    "search = [Path.cwd(), *Path.cwd().parents]\n",
    "if os.environ.get(\"LEUKEMIA_YOLO_ROOT\"):\n",
    "    search.insert(0, Path(os.environ[\"LEUKEMIA_YOLO_ROOT\"]))\n",
    "for candidate in search:\n",
    "    if (candidate / \"config.example.yaml\").is_file() and (candidate / \"src\" / \"classifier_config.py\").is_file():\n",
    "        sys.path.insert(0, str(candidate)); break\n",
    "from src.classifier_config import classifier_config, classifier_output\n",
    "cfg = classifier_config()\n",
    "out = classifier_output(cfg)\n",
    "print(\"Project:\", cfg[\"root\"])\n",
    "print(\"Config:\", cfg[\"config_path\"])\n",
    "print(\"C-NMC source:\", cfg[\"cnmc_root\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "feae82a3",
   "metadata": {},
   "source": [
